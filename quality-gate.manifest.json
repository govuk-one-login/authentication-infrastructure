{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "Authentication",
      "component": "authentication-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "integration"
            }
          ],
          "file": "configuration/di-authentication-build/frontend-pipeline/parameters.json",
          "path": "$[?@.ParameterKey=='OneLoginTestImageRepositoryNames']"
        }
      ]
    },
    {
      "product": "Authentication",
      "component": "authentication-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "canary"
            }
          ],
          "file": "configuration/di-authentication-build/frontend-pipeline/parameters.json",
          "path": "$[?@.ParameterKey=='ECSCanaryDeployment']"
        }
      ]
    },
    {
      "product": "Authentication",
      "component": "authentication-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "staging",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "canary"
            }
          ],
          "file": "configuration/di-authentication-staging/frontend-pipeline/parameters.json",
          "path": "$[?@.ParameterKey=='ECSCanaryDeployment']"
        }
      ]
    },
    {
      "product": "Authentication",
      "component": "authentication-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "production",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "canary"
            }
          ],
          "file": "configuration/di-authentication-production/frontend-pipeline/parameters.json",
          "path": "$[?@.ParameterKey=='ECSCanaryDeployment']"
        }
      ]
    },
    {
      "product": "Authentication",
      "component": "authentication-api",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "integration"
            }
          ],
          "file": "configuration/di-authentication-build/authentication-api-pipeline/parameters.json",
          "path": "$[?@.ParameterKey=='OneLoginTestImageRepositoryNames']"
        }
      ]
    },
    {
      "product": "Authentication",
      "component": "authentication-api",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "canary"
            }
          ],
          "file": "configuration/di-authentication-build/authentication-api-pipeline/parameters.json",
          "path": "$[?@.ParameterKey=='LambdaCanaryDeployment']"
        }
      ]
    }
  ]
}
